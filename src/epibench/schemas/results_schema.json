{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epibench.dev/schemas/results_v2.schema.json",
  "title": "EpiBench Evaluation Results v2",
  "type": "object",
  "required": [
    "benchmark",
    "scorer_version",
    "generator_version",
    "reader_prompt_version",
    "adapter_contract_version",
    "date_utc",
    "git_commit_sha",
    "manifest_sha256",
    "split",
    "seed",
    "filler_count",
    "token_budget",
    "reader_model",
    "judge_model",
    "secondary_audit_rate",
    "use_fakes",
    "experimental_tracks",
    "tracks",
    "systems",
    "total_scenarios",
    "validity_gate_summary",
    "spend_summary",
    "performance_summary",
    "scenario_results"
  ],
  "properties": {
    "benchmark": { "type": "string" },
    "scorer_version": { "type": "string", "minLength": 1 },
    "generator_version": { "type": "string", "minLength": 1 },
    "reader_prompt_version": { "type": "string", "minLength": 1 },
    "adapter_contract_version": { "type": "string", "minLength": 1 },
    "date_utc": { "type": "string" },
    "git_commit_sha": { "type": "string", "minLength": 1 },
    "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "split": { "type": "string" },
    "seed": { "type": "integer" },
    "filler_count": { "type": "integer", "minimum": 0 },
    "token_budget": { "type": "integer", "minimum": 1 },
    "reader_model": { "type": "string", "minLength": 1 },
    "judge_model": { "type": "string", "minLength": 1 },
    "secondary_audit_rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "use_fakes": { "type": "boolean" },
    "experimental_tracks": { "type": "array", "items": { "type": "string" } },
    "tracks": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "systems": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "total_scenarios": { "type": "integer", "minimum": 0 },
    "validity_gate_summary": {
      "type": ["object", "null"],
      "properties": {
        "live_verified": { "type": "boolean" },
        "all_tracks_passed": { "type": "boolean" },
        "passing_tracks": { "type": "array", "items": { "type": "string" } },
        "experimental_tracks": { "type": "array", "items": { "type": "string" } }
      }
    },
    "spend_summary": {
      "type": "object",
      "required": ["total_spend_usd", "hard_cap_usd", "total_input_tokens", "total_output_tokens"],
      "properties": {
        "total_spend_usd": { "type": "number", "minimum": 0 },
        "hard_cap_usd": { "type": "number", "exclusiveMinimum": 0 },
        "total_input_tokens": { "type": "integer", "minimum": 0 },
        "total_output_tokens": { "type": "integer", "minimum": 0 }
      }
    },
    "performance_summary": {
      "type": "object",
      "required": ["by_system", "by_track", "comparisons", "secondary_audit", "dimensional_reports"],
      "properties": {
        "by_system": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "question_accuracy",
              "question_correct",
              "question_total",
              "question_ci_95",
              "scenario_pass_rate",
              "scenario_passed",
              "scenario_total",
              "scenario_ci_95",
              "parse_failures",
              "judge_errors",
              "total_spend_usd",
              "cost_per_successful_answer_usd"
            ],
            "properties": {
              "question_accuracy": { "type": "number" },
              "question_correct": { "type": "integer" },
              "question_total": { "type": "integer" },
              "question_ci_95": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
              "scenario_pass_rate": { "type": "number" },
              "scenario_passed": { "type": "integer" },
              "scenario_total": { "type": "integer" },
              "scenario_ci_95": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
              "parse_failures": { "type": "integer", "minimum": 0 },
              "judge_errors": { "type": "integer", "minimum": 0 },
              "total_spend_usd": { "type": "number", "minimum": 0 },
              "cost_per_successful_answer_usd": { "type": ["number", "null"] }
            }
          }
        },
        "by_track": { "type": "object" },
        "comparisons": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["system_a", "system_b", "paired_questions", "mcnemar", "paired_scenario_bootstrap"],
            "properties": {
              "system_a": { "type": "string" },
              "system_b": { "type": "string" },
              "paired_questions": { "type": "integer", "minimum": 0 },
              "mcnemar": {
                "type": "object",
                "required": ["b", "c", "p_value", "holm_adjusted_p", "holm_significant_05"]
              },
              "paired_scenario_bootstrap": {
                "type": "object",
                "required": ["mean_diff", "ci_lower", "ci_upper", "p_value", "holm_adjusted_p", "holm_significant_05"]
              }
            }
          }
        },
        "secondary_audit": {
          "type": "object",
          "required": ["audit_count", "agreement_rate", "cohens_kappa"],
          "properties": {
            "audit_count": { "type": "integer", "minimum": 0 },
            "agreement_rate": { "type": ["number", "null"] },
            "cohens_kappa": { "type": ["number", "null"] }
          }
        },
        "dimensional_reports": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "factual_accuracy",
              "temporal_consistency",
              "dependency_reasoning",
              "constraint_compliance",
              "provenance",
              "calibration",
              "privacy_and_deletion",
              "retention_control",
              "composite_score",
              "included_dimensions",
              "excluded_dimensions",
              "total_spend_usd",
              "cost_per_successful_answer_usd"
            ],
            "properties": {
              "factual_accuracy": { "type": ["number", "null"] },
              "temporal_consistency": { "type": ["number", "null"] },
              "dependency_reasoning": { "type": ["number", "null"] },
              "constraint_compliance": { "type": ["number", "null"] },
              "provenance": { "type": ["number", "null"] },
              "calibration": { "type": ["number", "null"] },
              "privacy_and_deletion": { "type": ["number", "null"] },
              "retention_control": { "type": ["number", "null"] },
              "composite_score": { "type": ["number", "null"] },
              "included_dimensions": { "type": "array", "items": { "type": "string" } },
              "excluded_dimensions": { "type": "array", "items": { "type": "string" } },
              "total_spend_usd": { "type": "number", "minimum": 0 },
              "cost_per_successful_answer_usd": { "type": ["number", "null"] }
            }
          }
        }
      }
    },
    "scenario_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scenario_id", "track", "split", "question_date", "scenario_sha256", "system_results"]
      }
    }
  }
}
